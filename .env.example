# --- Model ---------------------------------------------------------------
# Default: free local model via Ollama (https://ollama.com)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1

# OpenAI instead (needed for a hosted demo, where Ollama isn't available):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# --- Storage -------------------------------------------------------------
DATABASE_URL=sqlite:///data/extractions.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Review --------------------------------------------------------------
REVIEW_THRESHOLD=0.7

# --- Limits and demo protection ------------------------------------------
MAX_UPLOAD_MB=5
MAX_PAGES=5
RATE_LIMIT_PER_HOUR=20
# Set this on a public deployment so only people you share it with can upload
DEMO_ACCESS_CODE=
